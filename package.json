{
  "name": "hygp-mockup-generator",
  "private": true,
  "description": "Etsy listing mockups: a fixed template photo, the real pattern file mapped onto it in code, and a model that only returns JSON.",
  "scripts": {
    "studio": "node src/studio.js",
    "preview": "node src/studio.js",
    "mockup": "node src/run.js",
    "plates:bg": "node src/generate-plates.js --kind backgrounds",
    "plates:dogs": "node src/generate-plates.js --kind dogs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "ag-psd": "^34.1.0",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
