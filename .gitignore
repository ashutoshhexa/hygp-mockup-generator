node_modules/

# render outputs (regenerate with npm run mockup / the Studio export)
out/
poc/out/

# source PSDs are huge; layers.bin is rebuilt from the PSD by src/tools/import-psd.js
*.psd
poc/templates/*/layers.bin

# working state written by the Studio
decisions/preview.json
decisions/.validate.json

poc/backgrounds/_rejected/

# metal bake: inputs are regenerated by `metal-bake.js prepare/pad`; keep only the model outputs
poc/metal-bake/*/in/
poc/metal-bake/*/padded/
poc/metal-bake/*/rejected-*/
poc/metal-bake/*/try*/

# storefront engraving fonts (list + font files), fetched by src/fonts.js
cache/
